    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const website = String($json.website || '').replace(/\\/$/, '');\n\nconst candidates = [\n  `${website}/contact`,\n  `${website}/contact-us`,\n  `${website}/contactus`,\n  `${website}/get-in-touch`,\n  website\n];\n\nreturn {\n  json: {\n    ...$json,\n    contactCandidates: candidates,\n    contactCandidateIndex: 0\n  }\n};"
      },
