        "jsCode": "const email = String($json.primaryEmail || '').trim().toLowerCase();\nconst syntaxOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nconst disposable = /@(mailinator|guerrillamail|10minutemail|tempmail)\\./i.test(email);\nreturn { json: { ...$json, emailValid: syntaxOk && !disposable, emailValidation: syntaxOk && !disposable ? 'valid_format' : 'invalid_or_disposable' } };"
      },
