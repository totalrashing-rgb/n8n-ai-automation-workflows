    {
      "parameters": {
        "jsCode": "const leads = $('Clean & Normalize Lead').all().map(i => i.json);\nconst existing = $input.all().map(i => i.json);\n\nconst existingKeys = new Set(\n  existing\n    .map(r => String(r['Lead Key'] || '').trim())\n    .filter(Boolean)\n);\n\nconst seen = new Set();\n\nreturn leads.map((lead) => {\n  const key = String(lead.leadKey || '').trim();\n  const alreadyInCRM = existingKeys.has(key);\n  const repeatedInSearch = seen.has(key);\n\n  const isDuplicate = alreadyInCRM || repeatedInSearch;\n\n  if (key) seen.add(key);\n\n  return {\n    json: {\n      ...lead,\n      isDuplicate,\n      duplicateReason: alreadyInCRM\n        ? 'Already exists in CRM'\n        : repeatedInSearch\n          ? 'Duplicate inside current search'\n          : ''\n    }\n  };\n});"
      },
