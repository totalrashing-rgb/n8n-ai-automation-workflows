        "jsCode": "const j = $json;\nconst name = String(j.title || '').trim();\nconst website = String(j.website || '').trim().replace(/\\/$/, '');\nconst address = String(j.address || '').trim();\nconst chatId = $('Extract Business Search').first().json.chatId || '';\nconst keyBase = website || address;\nconst key = `${name.toLowerCase().replace(/[^a-z0-9]+/g,'-')}:${keyBase.toLowerCase()}`;\nreturn {\n  json: {\n    ...j,\n    normalizedName: name,\n    normalizedWebsite: website,\n    leadKey: key,\n    chatId\n  }\n};"
