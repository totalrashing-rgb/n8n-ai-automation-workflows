    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw = $json.output || $json.text || '';\n\nlet parsed;\n\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (error) {\n  parsed = {\n    send: false,\n    confidence: 0,\n    subject: '',\n    body: '',\n    reason: 'Invalid AI JSON'\n  };\n}\n\nconst subject = String(parsed.subject || '').trim();\nconst body = String(parsed.body || '').trim();\n\nconst forbiddenPlaceholders = [\n  '[name]',\n  '[your name]',\n  '[company name]',\n  '{{name}}',\n  '{{company}}',\n  '{{client_name}}',\n  '{{your name}}'\n];\n\nconst lowerText = `${subject}\\n${body}`.toLowerCase();\n\nconst containsPlaceholder = forbiddenPlaceholders.some(\n  placeholder => lowerText.includes(placeholder)\n);\n\nconst hasSubject = subject.length > 0;\nconst hasBody = body.length > 0;\nconst bodyLengthOk = body.length <= 1200;\nconst wordCount = body.split(/\\s+/).filter(Boolean).length;\nconst wordCountOk = wordCount <= 120;\nconst recipient = String($('Email Validation').item.json.primaryEmail || '').trim();\nconst recipientOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(recipient);\n\nconst hasGreeting =\n  /^(hi|hello|hey)\\s+(team|there)/i.test(body);\n\nconst hasSignature =\n  /best regards|regards|thanks|thank you/i.test(body);\n\nconst confidenceOk =\n  Number(parsed.confidence || 0) >= 0.75;\n\nconst safetyPassed =\n  Boolean(parsed.send) &&\n  confidenceOk &&\n  hasSubject &&\n  hasBody &&\n  bodyLengthOk &&\n  wordCountOk &&\n  hasGreeting &&\n  hasSignature &&\n  !containsPlaceholder &&\n  recipientOk;\n\nreturn {\n  json: {\n    ...$json,\n    send: Boolean(parsed.send),\n    confidence: Number(parsed.confidence || 0),\n    subject,\n    body,\n    safetyPassed,\n    safetyReason: safetyPassed\n      ? 'Passed'\n      : 'Failed email safety validation'\n  }\n};"
      },
