    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = String($json.data || '');\nconst found = html.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi) || [];\nconst blocked = ['example.com','sentry.io'];\nconst emails = [...new Set(found.map(x => x.toLowerCase()))].filter(e => !blocked.some(x => e.includes(x)));\nconst priority = ['info@','hello@','contact@','sales@','support@','admin@','office@'];\nemails.sort((a,b) => {\n  const ai = priority.findIndex(p => a.startsWith(p));\n  const bi = priority.findIndex(p => b.startsWith(p));\n  return (ai < 0 ? 999 : ai) - (bi < 0 ? 999 : bi);\n});\nreturn { json: { ...$json, primaryEmail: emails[0] || '', emailCount: emails.length, emails } };"
      },
