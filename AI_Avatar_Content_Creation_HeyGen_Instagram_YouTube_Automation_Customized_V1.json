{
  "name": "AI Avatar Content Creation & Instagram + YouTube Publishing Automation",
  "nodes": [
    {
      "parameters": {
        "formTitle": "AI Avatar Content Publisher",
        "formDescription": "Submit a topic and schedule. AI writes the script, HeyGen creates the avatar video, and the result is prepared for Instagram and YouTube.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Category",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "AI & Automation"
                  },
                  {
                    "option": "Business Tips"
                  },
                  {
                    "option": "Tech News"
                  },
                  {
                    "option": "Motivation"
                  },
                  {
                    "option": "Education"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Title",
              "placeholder": "e.g. Top 5 AI Tools for 2025",
              "requiredField": true
            },
            {
              "fieldLabel": "Post Time",
              "fieldType": "datetime",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "id": "3ddf0199-16b1-4e07-a918-5c2b13b63e2b",
      "name": "Trigger • Content Submission Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -2720,
        400
      ],
      "webhookId": "534a4fe9-ab4b-4ecb-bff9-29a29ec34cbb"
    },
    {
      "parameters": {
        "jsCode": "const formData = $input.first().json;\nconst category = formData['Category'] || 'Education';\nconst title = formData['Title'] || '';\nconst postTime = formData['Post Time'] || '';\nconst toneMap = {\n  'AI & Automation': 'educational, practical, futuristic',\n  'Business Tips': 'professional, actionable, clear',\n  'Tech News': 'informative, crisp, current',\n  'Motivation': 'energetic, uplifting, inspiring',\n  'Education': 'simple, structured, approachable'\n};\nconst tone = toneMap[category] || 'engaging, informative';\nconst language = $env.CONTENT_LANGUAGE || 'Hinglish';\n\nreturn [{\n  json: {\n    category, title, postTime, tone, language,\n    promptInstruction: `You are an expert short-form content writer for the ${category} niche.\n\nWrite a natural AI-avatar video script.\n\nTitle: \"${title}\"\nCategory: ${category}\nTone: ${tone}\nLanguage: ${language}\n\nRequirements:\n- 45–60 seconds spoken duration, roughly 120–150 words.\n- Strong hook in the first 5 seconds.\n- One clear and useful idea.\n- Conversational language suitable for an AI avatar.\n- End with a concise CTA.\n- No stage directions or camera instructions.\n- Do not invent statistics, prices, product features, news or unsupported claims.\n- Return only the spoken script.`\n  }\n}];"
      },
      "id": "ca504082-a2ad-4a0b-9bc2-d3ba071ea1f4",
      "name": "Logic • Prepare Content Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2496,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": {{ JSON.stringify($json.promptInstruction) }}\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.7,\n    \"maxOutputTokens\": 1000\n  }\n}",
        "options": {}
      },
      "id": "e144d9b8-42c8-4b57-8c91-73449b793b94",
      "name": "AI • Generate Video Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2288,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst script = response.candidates?.[0]?.content?.parts?.[0]?.text || '';\n\nconst prevData = $('Logic • Prepare Content Data').first().json;\n\nif (!script) {\n  throw new Error('Gemini se script nahi mili! Response: ' + JSON.stringify(response));\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    script: script.trim()\n  }\n}];"
      },
      "id": "6db51632-e96c-4596-935e-6e78d0e4b4e7",
      "name": "Logic • Extract Generated Script",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2064,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v2/video/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.HEYGEN_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_inputs\": [{\n    \"character\": {\n      \"type\": \"avatar\",\n      \"avatar_id\": \"{{ $env.HEYGEN_AVATAR_ID }}\",\n      \"avatar_style\": \"normal\"\n    },\n    \"voice\": {\n      \"type\": \"text\",\n      \"input_text\": {{ JSON.stringify($json.script) }},\n      \"voice_id\": \"{{ $env.HEYGEN_VOICE_ID }}\",\n      \"speed\": {{ $env.HEYGEN_VOICE_SPEED || 1.0 }}\n    },\n    \"background\": {\n      \"type\": \"color\",\n      \"value\": \"{{ $env.HEYGEN_BACKGROUND_COLOR || '#0f0f1a' }}\"\n    }\n  }],\n  \"dimension\": {\n    \"width\": 1080,\n    \"height\": 1920\n  },\n  \"aspect_ratio\": \"9:16\",\n  \"test\": false\n}",
        "options": {}
      },
      "id": "495c7c2d-12d1-4447-8379-bdf8fd24a544",
      "name": "HeyGen • Create Avatar Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1840,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst videoId = response.data?.video_id || response.video_id;\n\nif (!videoId) {\n  throw new Error('HeyGen video_id nahi mila! Response: ' + JSON.stringify(response));\n}\n\nconst prevData = $('Logic • Extract Generated Script').first().json;\n\nreturn [{\n  json: {\n    ...prevData,\n    heygenVideoId: videoId,\n    heygenStatus: 'processing'\n  }\n}];"
      },
      "id": "e239a68f-1781-4f8a-9721-0e60f1851781",
      "name": "Logic • Save HeyGen Video ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1616,
        400
      ]
    },
    {
      "parameters": {
        "amount": 60
      },
      "id": "d2cc5b90-bd1d-4d80-91fc-0a75386cb443",
      "name": "HeyGen • Wait for Processing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -1408,
        400
      ],
      "webhookId": "wait-heygen-001"
    },
    {
      "parameters": {
        "url": "=https://api.heygen.com/v1/video_status.get?video_id={{ $('Logic • Save HeyGen Video ID').first().json.heygenVideoId }}",
        "sendHeaders": true,
        "headerParameters": {
