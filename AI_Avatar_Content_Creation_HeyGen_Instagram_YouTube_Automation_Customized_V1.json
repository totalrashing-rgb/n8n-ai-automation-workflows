      "id": "34be34df-8070-46b4-9d21-9fab8aa9bb3f",
      "name": "Instagram • Publish Reel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        368,
        256
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/youtube/v3/videos?part=snippet,status&uploadType=multipart",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.YOUTUBE_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"snippet\": {\n    \"title\": {{ JSON.stringify($('Logic • Parse Social Captions').first().json.title) }},\n    \"description\": {{ JSON.stringify($('Logic • Parse Social Captions').first().json.youtubeDescription) }},\n    \"categoryId\": \"{{ $env.YOUTUBE_CATEGORY_ID || '28' }}\",\n    \"tags\": [\"Shorts\", \"AI\", \"Automation\", {{ JSON.stringify($('Logic • Parse Social Captions').first().json.category) }}]\n  },\n  \"status\": {\n    \"privacyStatus\": \"{{ $env.YOUTUBE_PRIVACY_STATUS || 'private' }}\",\n    \"selfDeclaredMadeForKids\": false\n  }\n}",
        "options": {}
      },
      "id": "af6013c4-b03c-43d5-8d20-bfaf4d319e55",
      "name": "YouTube • Publish Short",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        544
