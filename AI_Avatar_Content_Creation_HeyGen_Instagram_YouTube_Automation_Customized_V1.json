            {
              "name": "X-Api-Key",
              "value": "={{ $env.HEYGEN_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f1027aee-461b-4dba-a2e0-5090df99ff94",
      "name": "HeyGen • Check Video Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1184,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.data?.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "88af9bf5-47d2-4b42-b3f0-6f464120227f",
      "name": "Routing • Video Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -960,
        400
      ]
    },
    {
      "parameters": {
        "amount": 30
      },
      "id": "a29aecdb-4bc2-4c10-bc1f-b7715fbaabff",
      "name": "HeyGen • Retry Status Check",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -960,
        624
      ],
      "webhookId": "wait-heygen-retry"
    },
    {
      "parameters": {
        "jsCode": "const statusResponse = $input.first().json;\nconst videoUrl = statusResponse.data?.video_url || statusResponse.video_url;\nconst thumbnailUrl = statusResponse.data?.thumbnail_url || '';\n\nconst prevData = $('Logic • Save HeyGen Video ID').first().json;\n\nif (!videoUrl) {\n  throw new Error('Video URL nahi mila: ' + JSON.stringify(statusResponse));\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    videoUrl,\n    thumbnailUrl,\n    heygenStatus: 'completed'\n  }\n}];"
      },
      "id": "932d824c-e22f-48b7-906d-445ee85e7de3",
      "name": "Logic • Extract Final Video URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -736,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": {{ JSON.stringify(\n`Create social copy for this short-form avatar video.\n\nTitle: ${$json.title}\nCategory: ${$json.category}\nScript Preview: ${$json.script.substring(0, 300)}\n\nGenerate:\n---INSTAGRAM---\nEngaging caption, 120–180 words, ${$env.CONTENT_LANGUAGE || 'Hinglish'}, relevant hashtags and a clear CTA.\n---YOUTUBE---\nProfessional Shorts description, 80–120 words, with relevant hashtags.\n\nDo not invent statistics, prices, product features, news or unsupported claims.\nReturn exactly the two sections shown above.`) }}\n    }]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.7,\n    \"maxOutputTokens\": 800\n  }\n}",
        "options": {}
      },
      "id": "09893d9e-7a72-44d8-b120-df38f09afcfa",
      "name": "AI • Generate Social Captions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -528,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst fullText = response.candidates?.[0]?.content?.parts?.[0]?.text || '';\n\nconst instagramMatch = fullText.match(/---INSTAGRAM---([\\s\\S]*?)---YOUTUBE---/);\nconst youtubeMatch = fullText.match(/---YOUTUBE---([\\s\\S]*)$/);\n\nconst instagramCaption = instagramMatch ? instagramMatch[1].trim() : fullText.substring(0, 500);\nconst youtubeDescription = youtubeMatch ? youtubeMatch[1].trim() : fullText.substring(500);\n\nconst prevData = $('Logic • Extract Final Video URL').first().json;\n\nreturn [{\n  json: {\n    ...prevData,\n    instagramCaption,\n    youtubeDescription\n  }\n}];"
      },
      "id": "280f349a-bedb-4f38-957f-0eb8bd88885b",
      "name": "Logic • Parse Social Captions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.INSTAGRAM_ACCOUNT_ID }}/media",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "REELS"
            },
            {
              "name": "video_url",
              "value": "={{ $json.videoUrl }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.instagramCaption }}"
            },
            {
              "name": "share_to_feed",
              "value": "true"
            },
            {
              "name": "access_token",
              "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "34016b91-ed31-4408-a08a-9588a0d7a7a8",
      "name": "Instagram • Create Reel Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        256
      ]
    },
    {
      "parameters": {
        "amount": 30
      },
      "id": "96e196de-e057-448b-9851-a0a6da48a822",
      "name": "Instagram • Wait for Container",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        144,
        256
      ],
      "webhookId": "wait-insta-001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.INSTAGRAM_ACCOUNT_ID }}/media_publish",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
