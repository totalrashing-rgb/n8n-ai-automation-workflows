        "emailType": "text",
        "message": "=Hello Support Team,\n\nAn urgent customer feedback item has been detected.\n\nCustomer: {{ $('Trigger • Customer Feedback Form').item.json['Customer Name'] }}\nEmail: {{ $('Trigger • Customer Feedback Form').item.json['Customer Email'] }}\nOrder ID: {{ $('Trigger • Customer Feedback Form').item.json['Order ID'] || 'Not provided' }}\n\nSentiment: {{ $('Logic • Parse Feedback Analysis').item.json.sentiment }}\nCategory: {{ $('Logic • Parse Feedback Analysis').item.json.category }}\nSummary: {{ $('Logic • Parse Feedback Analysis').item.json.summary }}\n\nPlease review the issue using your normal support process.\n\nRegards,\n{{ $env.SUPPORT_AGENT_NAME || 'Customer Support' }}",
        "options": {
