      "id": "f80af6b5-f97e-4175-a3b4-07e55053e258",
      "name": "AI Model • Feedback Analysis"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.output ?? '').trim();\n\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(`Feedback analysis JSON could not be parsed: ${error.message}`);\n}\n\nreturn [{\n  json: {\n    sentiment: parsed.sentiment || 'neutral',\n    category: parsed.category || 'other',\n    summary: parsed.summary || 'No summary generated.',\n    urgent: Boolean(parsed.urgent),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
