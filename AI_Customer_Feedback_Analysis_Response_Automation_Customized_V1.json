    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the customer feedback below and return valid JSON only.\n\nCustomer feedback:\n{{ $json['Feedback'] }}\n\nReturn exactly:\n{\n  \"sentiment\": \"positive|neutral|negative\",\n  \"category\": \"product|service|delivery|support|billing|other\",\n  \"summary\": \"A concise factual summary of the feedback.\",\n  \"urgent\": false\n}\n\nRules:\n- Use only information present in the feedback.\n- Do not invent causes, refunds, timelines, policies, or promises.\n- Set urgent=true only for a serious complaint, safety issue, major service failure, or issue clearly needing prompt human attention.\n- Keep the summary concise and factual.",
        "options": {
          "systemMessage": "You are a customer-feedback triage assistant. Be factual, conservative, and structured."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
