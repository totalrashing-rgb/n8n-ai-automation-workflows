      "id": "249512ff-3c18-40ce-9ea5-dbb0c5b79806",
      "name": "Lead • Get Broker List",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Prefer a broker whose Areas field matches the client's location.\n// If there is no match, use a deterministic fallback instead of random assignment.\nconst brokers = $input.all().map(item => item.json).filter(Boolean);\nif (!brokers.length) throw new Error('No brokers returned. Check BROKERS_SHEET_ID and the Brokers sheet.');\n\nconst lead = $('AI • Real Estate Assistant').item.json.output || {};\nconst location = String(lead.preferred_location || '').toLowerCase().trim();\n\nlet pool = brokers;\nif (location) {\n  const matched = brokers.filter(b => {\n    const areas = String(b.Areas || b.areas || '').toLowerCase();\n    return areas && (areas.includes(location) || location.includes(areas));\n  });\n  if (matched.length) pool = matched;\n}\n\nconst phone = String($('Core • Extract Customer Message').item.json.customer_phone || '');\nlet hash = 0;\nfor (const ch of phone) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;\nconst chosen = pool[hash % pool.length];\n\nreturn [{ json: {\n  broker_name: chosen.Name || chosen.name || 'Broker',\n  broker_phone: chosen.Phone || chosen.phone || '',\n  broker_email: chosen.Email || chosen.email || ''\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4720,
        2752
      ],
      "id": "2b8ba8d6-18c7-4517-a2ff-f7900b7b88a8",
      "name": "Lead • Assign Broker"
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WA_PHONE_NUMBER_ID || 'REPLACE_WITH_META_PHONE_NUMBER_ID' }}",
        "recipientPhoneNumber": "={{ $json.broker_phone }}",
        "textBody": "=New WhatsApp lead 🏠\n\nClient: {{ $('Core • Extract Customer Message').item.json.customer_name }}\nPhone: {{ $('Core • Extract Customer Message').item.json.customer_phone }}\n\nMessage: {{ $('Core • Extract Customer Message').item.json.message_text }}\n\nProperty type: {{ $('AI • Real Estate Assistant').item.json.output.property_type }}\nBudget: {{ $('AI • Real Estate Assistant').item.json.output.budget_range }}\nLocation: {{ $('AI • Real Estate Assistant').item.json.output.preferred_location }}\nUrgency: {{ $('AI • Real Estate Assistant').item.json.output.urgency }}\n\nSummary: {{ $('AI • Real Estate Assistant').item.json.output.lead_summary }}\n\nPlease contact the client soon.",
