    {
      "parameters": {
        "jsCode": "// Parse the call summary payload sent by the LiveKit Voice AI Agent\nconst body = $json.body || $json;\n\nconst roomName         = body.room_name         || '';\nconst customerPhone    = body.customer_phone    || '';\nconst durationSeconds  = body.duration_seconds  || 0;\nconst transcript       = body.transcript        || '';\nconst callSummary      = body.call_summary      || '';\nconst propertyType     = body.property_type     || '';\nconst budgetRange      = body.budget_range      || '';\nconst preferredLoc     = body.preferred_location|| '';\nconst urgency          = body.urgency           || 'unknown';\nconst recordingUrl     = body.recording_url     || '';\n\nconst durationMin = Math.floor(durationSeconds / 60);\nconst durationSec = durationSeconds % 60;\nconst durationStr = `${durationMin}m ${durationSec}s`;\n\nreturn [{\n  json: {\n    room_name:          roomName,\n    customer_phone:     customerPhone,\n    duration_str:       durationStr,\n    transcript:         transcript,\n    call_summary:       callSummary,\n    property_type:      propertyType,\n    budget_range:       budgetRange,\n    preferred_location: preferredLoc,\n    urgency:            urgency,\n    recording_url:      recordingUrl\n  }\n}];"
      },
