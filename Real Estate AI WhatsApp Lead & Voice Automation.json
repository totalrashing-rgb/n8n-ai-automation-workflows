    {
      "parameters": {
        "jsCode": "// Prepare a secure server-side LiveKit token request.\n// Keep the LiveKit API secret outside n8n.\nconst roomName = $('Voice • Create Room Name').item.json.room_name;\nconst customerPhone = $('Core • Extract Customer Message').item.json.customer_phone;\nconst customerName = $('Core • Extract Customer Message').item.json.customer_name;\nreturn [{ json: { room_name: roomName, customer_identity: customerPhone, customer_name: customerName } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4912,
        2416
      ],
      "id": "3125daa3-b032-46b3-a75e-ea78d184b97f",
      "name": "Voice • Prepare Customer Token"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.LIVEKIT_TOKEN_SERVER_URL || 'https://REPLACE_WITH_TOKEN_SERVER_URL').replace(/\\/+$/, '') + '/generate-token' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"room\": \"{{ $json.room_name }}\",\n  \"identity\": \"{{ $json.customer_identity }}\",\n  \"name\": \"{{ $json.customer_name }}\",\n  \"grants\": {\n    \"roomJoin\": true,\n    \"room\": \"{{ $json.room_name }}\",\n    \"canPublish\": true,\n    \"canSubscribe\": true\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        5152,
        2416
      ],
      "id": "2808fe6f-5c17-4c36-a583-f788e3be2462",
      "name": "Voice • Generate Customer Token",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Build the customer-facing LiveKit join URL.\n// LIVEKIT_SERVER_URL may be https://... or wss://...\nconst token = $json.token || $json.accessToken || $json.access_token;\nconst roomName = $('Voice • Create Room Name').item.json.room_name;\nif (!token) throw new Error('LiveKit customer token was not returned.');\n\nconst configuredUrl = String($env.LIVEKIT_SERVER_URL || 'wss://REPLACE_WITH_LIVEKIT_SERVER_URL').replace(/\\/+$/, '');\nconst livekitUrl = configuredUrl.startsWith('https://')\n  ? configuredUrl.replace(/^https:\\/\\//, 'wss://')\n  : configuredUrl.startsWith('http://')\n    ? configuredUrl.replace(/^http:\\/\\//, 'ws://')\n    : configuredUrl;\n\nconst joinUrl = `https://meet.livekit.io/?liveKitUrl=${encodeURIComponent(livekitUrl)}&token=${encodeURIComponent(token)}`;\nreturn [{ json: { join_url: joinUrl, room_name: roomName, token } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5392,
        2416
      ],
      "id": "32ca95b4-74ec-4685-b52d-f43d01c9fad5",
      "name": "Voice • Build Customer Join Link"
    },
