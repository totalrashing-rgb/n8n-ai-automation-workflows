        "jsCode": "// Generate a unique LiveKit room name for this customer + session\nconst phone = $('Core • Extract Customer Message').item.json.customer_phone;\nconst ts = Date.now().toString(36);\nconst roomName = `re-${phone.slice(-6)}-${ts}`;\n\nreturn [{ json: { room_name: roomName } }];"
      },
