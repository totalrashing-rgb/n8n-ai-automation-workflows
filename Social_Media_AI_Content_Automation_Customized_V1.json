        "caption": "={{ (() => {\nconst s = $('AI • Content Strategist').item.json.output;\nconst c = $('AI • Caption Writer').item.json.output;\nconst h = $('AI • Hashtag Generator').item.json.output;\nconst parse = (v) => { if (typeof v !== 'string') return v; try { return JSON.parse(v); } catch(e) { return {value:v}; } };\nconst sp = parse(s), cp = parse(c), hp = parse(h);\nreturn [sp?.topic, cp?.caption, hp?.hashtags].filter(Boolean).join('\\n\\n');\n})() }}",
