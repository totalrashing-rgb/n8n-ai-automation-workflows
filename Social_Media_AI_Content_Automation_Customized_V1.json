    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior Instagram content strategist.\n\nCreate ONE practical content idea for the brand.\n\nReturn ONLY valid JSON in exactly this structure:\n{\n  \"topic\": \"\",\n  \"hook\": \"\",\n  \"key_points\": [],\n  \"cta\": \"\"\n}\n\nNiche: {{ $json.Niche }}\nTarget audience: {{ $json.TargetAudience }}\nPlatform: {{ $json.Platform }}\nContent pillar: {{ $json.ContentPillar }}\nBrand tone: {{ $json.BrandTone }}\nContent format: {{ $json.ContentFormat }}\n\nRules:\n- Make the idea useful and specific to the target audience.\n- Avoid generic or repetitive topics.\n- Do not invent statistics, customer results, product claims or facts that are not provided.\n- Keep the hook attention-grabbing but truthful.\n- Generate today's content idea.",
        "options": {}
      },
