      "parameters": {
        "content": "# ✅ STEP 2 — Create Video Using Veo3\n\n",
        "height": 280,
        "width": 1200,
        "color": 3
      },
      "id": "4f4cc9b8-5892-445a-95dd-11f2c267b064",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
